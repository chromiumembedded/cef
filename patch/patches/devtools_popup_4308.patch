+void RenderFrameDevToolsAgentHost::RenderFrameCreated(
+    RenderFrameHost* render_frame_host) {
+  if (render_frame_host == frame_host_ && !render_frame_alive_) {
+    // A renderer-created popup can be auto-attached before its frame is live.
+    // Bind the renderer channel now so that the paused popup can receive
+    // Runtime.runIfWaitingForDebugger without waiting for a navigation.
+    UpdateFrameAlive();
+  }
+}
