 #include "third_party/skia/include/gpu/graphite/Recorder.h"
 #endif  // BUILDFLAG(USE_DAWN)
 
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+#include <errno.h>
+#include <sys/ioctl.h>
+
+#include "base/posix/eintr_wrapper.h"
+#include "ui/gfx/linux/dmabuf_uapi.h"
